{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"resolveJsonModule": true,
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker.ts", "src/**/*.test.ts", "src/test-setup.ts"]
}
